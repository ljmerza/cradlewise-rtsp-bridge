# Cradlewise account credentials (same account as the mobile app). REQUIRED —
# these are the only vars you must set. The bridge discovers every crib on the
# account and publishes each to rtsp://<host>:8554/cradlewise_<baby_name>.
CRADLEWISE_EMAIL=
CRADLEWISE_PASSWORD=

# ── RTSP authentication ─────────────────────────────────────────────────────
# The RTSP server (mediamtx) requires a login to watch the cribs. REQUIRED: set
# the read credentials below (what Frigate / your NVR will use), or the container
# refuses to start. 8+ chars; the user may only use A-Z a-z 0-9 . _ - and the
# password must not contain ':' or control characters. Use a password you don't
# reuse anywhere else: RTSP sends it unencrypted unless you add TLS.
# Consumers then use:  rtsp://<RTSP_READ_USER>:<password>@<host>:8554/cradlewise_<baby_name>
# (URL-encode special characters in the password, e.g. @ -> %40, / -> %2F, # -> %23)
RTSP_READ_USER=
RTSP_READ_PASSWORD=

# The bridge's own publish login. Optional: unset = a random password is generated
# on every start and handed to the bridge, which is the recommended setup. Publishing
# is only accepted from 127.0.0.1 / ::1 (inside the container) either way.
# RTSP_PUBLISH_USER=bridge
# RTSP_PUBLISH_PASSWORD=

# Escape hatch: serve the streams to ANYONE who can reach the port, no password.
# Only for a trusted/isolated network, or to keep an old consumer working while you
# migrate it. A loud warning is logged at every start. Cannot be combined with
# RTSP_READ_USER / RTSP_READ_PASSWORD.
# RTSP_ALLOW_ANONYMOUS=true

# ── Optional (sensible defaults) ────────────────────────────────────────────
# Device NAME used to provision a stable, registered device_id (the videoRoom
# API rejects unregistered ids). A Cradlewise account has a device-slot limit; if
# provisioning fails with HTTP 422 DEVICE_ASSIGNMENT_FAILED, free a slot in the
# app (remove an unused device) or set this to an already-registered name.
# CRADLEWISE_DEVICE_NAME=cradlewise-rtsp-bridge

# Base RTSP target inside the container (no credentials here; the publish login
# is added automatically); each crib is published to
# "<RTSP_BASE>/cradlewise_<baby_name>". Usually leave unset.
# RTSP_BASE=rtsp://127.0.0.1:8554

# Include each crib's audio track in the published stream (1/0).
# CRADLEWISE_AUDIO=1

# Burn a wall-clock timestamp into the video. One var does both jobs: leaving it
# unset (or 0/false/no/off) means NO overlay; any position value turns it on and
# says where it goes. Valid: top-left, top-center, top-right, bottom-left,
# bottom-center, bottom-right (tl/tc/tr/bl/bc/br also work). A bare 1/true/yes
# uses bottom-left. The clock is the container's local time — set TZ too, or it
# stamps UTC.
# CRADLEWISE_TIMESTAMP=bottom-left
# TZ=America/New_York

# LOG_LEVEL=INFO
